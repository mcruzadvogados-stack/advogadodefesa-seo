Options -Indexes

# ── Página de erro customizada ────────────────────────────────────────────────
ErrorDocument 404 /404.php
ErrorDocument 500 /404.php

# ── Compressão gzip (mod_deflate) ────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE text/javascript application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/xml application/xhtml+xml
    AddOutputFilterByType DEFLATE image/svg+xml font/woff font/woff2 application/font-woff application/font-woff2
    # Não comprimir arquivos já comprimidos
    SetEnvIfNoCase Request_URI \.(gif|jpe?g|png|webp|mp4|webm|zip|gz)$ no-gzip
    Header append Vary Accept-Encoding env=!no-gzip
</IfModule>

# Redirecionar /mapa → Google Maps do escritório (antes de qualquer rewrite)
Redirect 301 /mapa https://maps.google.com/?q=-26.4939913,-49.0811204

# ── Security Headers ──────────────────────────────────────────────────────────
<IfModule mod_headers.c>
    # HSTS — forçar HTTPS por 1 ano, incluindo subdomínios
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # Bloquear iframes de outros domínios (clickjacking)
    Header always set X-Frame-Options "SAMEORIGIN"

    # Bloquear MIME-type sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Referrer: enviar origem apenas em HTTPS same-origin
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Permissions Policy — desativar recursos sensíveis não usados
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"

    # Content Security Policy
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://maps.googleapis.com https://connect.facebook.net https://kit.fontawesome.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com https://ka-f.fontawesome.com; img-src 'self' data: https://www.google-analytics.com https://www.googletagmanager.com https://maps.gstatic.com https://maps.googleapis.com; connect-src 'self' https://www.google-analytics.com https://analytics.google.com https://region1.google-analytics.com https://ka-f.fontawesome.com; frame-src https://www.google.com https://maps.google.com https://maps.google.com.br; object-src 'none'; base-uri 'self';"

    # Remover header X-Powered-By
    Header unset X-Powered-By
</IfModule>

# ── Cache — sem cache para HTML/PHP/CSS/JS ────────────────────────────────────
<IfModule mod_headers.c>
    # PHP/HTML: nunca cachear (garante CSS e vídeos atualizados)
    <FilesMatch "\.(php|html|htm)$">
        Header set Cache-Control "no-store, no-cache, must-revalidate"
        Header unset ETag
        Header unset Last-Modified
        Header unset Pragma
    </FilesMatch>
    # CSS/JS: sem cache
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "no-store, no-cache, must-revalidate"
        Header unset ETag
        Header unset Last-Modified
    </FilesMatch>
    # Vídeos: cache longo (nomes versionados controlam atualização)
    <FilesMatch "\.(mp4|webm)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # Imagens e fontes: cache 1 ano (nomes estáticos — não mudam)
    <FilesMatch "\.(png|jpg|jpeg|gif|webp|svg|ico|woff|woff2|ttf|eot)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
<IfModule mod_expires.c>
    <FilesMatch "\.(css|js|php|html)$">
        ExpiresActive Off
    </FilesMatch>
    <FilesMatch "\.(mp4|webm)$">
        ExpiresActive On
        ExpiresDefault "access plus 1 year"
    </FilesMatch>
</IfModule>

RewriteEngine On

# Redirecionar www → sem www (canonical)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# Redirecionar /mapa → Google Maps do escritório
RewriteRule ^mapa/?$ https://maps.google.com/?q=-26.4939913,-49.0811204 [R=301,L]

# Servir arquivos PHP reais diretamente (subpáginas com SEO)
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Servir diretórios reais diretamente
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Clean URLs → PHP files (se existirem)
RewriteCond %{DOCUMENT_ROOT}/$1.php -f
RewriteRule ^([a-z0-9_-]+)/?$ /$1.php [L,NC]

# Rota interna CMS
RewriteRule ^ index.php [L]
